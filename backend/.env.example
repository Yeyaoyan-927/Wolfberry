# 配置模板：复制为 .env.dev / .env.staging / .env.prod 后填值
# 优先级：.env  <  .env.<APP_ENV>  <  进程环境变量

APP_ENV=dev
DEBUG=true

# ---------- 数据库 ----------
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/wolfberry?charset=utf8mb4

# ---------- 鉴权 ----------
JWT_SECRET=change-me-in-every-env
JWT_EXPIRE_MINUTES=240

# ---------- 对象存储 ----------
# auto: 有凭据走 COS，无凭据自动降级本地（便于本地开发）
STORAGE_DRIVER=auto
STORAGE_PUBLIC_BASE=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=wolfberry-1361042049
COS_REGION=ap-shanghai
COS_DOMAIN=wolfberry-1361042049.cos.ap-shanghai.myqcloud.com
COS_PUBLIC_READ=false
COS_SIGNED_URL_TTL=3600

# ---------- 大模型 / 向量 ----------
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-plus
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ---------- RAG ----------
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_MIN_SCORE=0.18
